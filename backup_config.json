{
  "nas_mount_point": "/media/nas/backup",
  "backup_destination_subfolder": "portainer_docker",
  "containers": [
    {
      "name": "portainer",
      "stop": true,
      "group": "portainer",
      "volumes": [
        "portainer_data"
      ],
      "paths": []
    },
    {
      "name": "cloudflared-tunnel",
      "stop": false,
      "paths": []
    },
    {
      "name": "homeassistant",
      "stop": false,
      "paths": [
        {
          "path": "/docker/homeassistant/config/backups",
          "archive": false
        }
      ]
    },
    {
      "name": "mosquitto",
      "stop": true,
      "group": "zigbee_mqtt_stack",
      "paths": [
        {
          "path": "/docker/mosquitto",
          "archive": true
        }
      ]
    },
    {
      "name": "zigbee2mqtt",
      "stop": true,
      "group": "zigbee_mqtt_stack",
      "paths": [
        {
          "path": "/docker/zigbee2mqtt",
          "archive": true
        }
      ]
    },
    {
      "name": "nginx-proxy-manager",
      "stop": false,
      "paths": [
        {
          "path": "/docker/nginx-proxy-manager",
          "archive": true
        }
      ]
    },
    {
      "name": "pihole",
      "stop": true,
      "group": "pihole",
      "paths": [
        {
          "path": "/docker/pihole",
          "archive": true
        }
      ]
    },
    {
      "name": "qbittorrent",
      "stop": true,
      "paths": [
        {
          "path": "/docker/qbittorrent",
          "archive": true
        }
      ]
    },
    {
      "name": "transmission",
      "stop": true,
      "paths": [
        {
          "path": "/docker/transmission",
          "archive": true
        }
      ]
    },
    {
      "name": "wg-easy",
      "stop": false,
      "paths": [
        {
          "path": "/docker/wg-easy",
          "archive": true
        }
      ]
    }
  ]
}